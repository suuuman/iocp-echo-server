# 접속 설정 견본.
# 이 파일을 config/db.ini 로 복사한 뒤 값을 채운다.
# config/db.ini 는 .gitignore 대상이며 커밋되지 않는다.

[mysql]
host     = 127.0.0.1
port     = 3306
user     = echo
password = 여기에_비밀번호
schema   = echodb

# DB 워커 스레드 수. 커넥션 풀 크기와 동일하게 유지한다
worker_count = 4

# 커넥션 1개의 응답 대기 상한(ms). 초과 시 끊김으로 판정하고 재연결한다
timeout_ms = 5000

# 요청 하나에 주는 시간(ms). 큐에 들어간 시점부터 센다. 0 이면 기한을 두지 않는다.
# 기한을 넘긴 요청은 질의를 시작하지 않고 오류 코드 21 로 답한다.
# 이 판정이 없으면 앞선 요청이 늦은 만큼 뒤에 선 요청도 그대로 늦는다
request_timeout_ms = 3000

# DB 접근 경로
#   0 - 직접 SQL. 애플리케이션이 구문을 나눠 보내고 트랜잭션도 직접 연다
#   1 - 저장 프로시저. 한 번의 호출로 끝난다 (sql/002_procedures.sql 적용 필요)
use_procedures = 0

# 워커 배정 방식. 같은 세션 키의 순서는 어느 쪽이든 보장된다
#   static  - hash(session_key) % worker_count 로 워커를 고정한다.
#             배정에 잠금도 상태도 없다. 대신 분산이 정적이다
#   dynamic - 처리 중인 키를 피해 한가한 워커가 집는다.
#             부하가 키마다 달라도 워커가 놀지 않는다. 대신 배정마다 잠금을 잡는다
dispatch = static

# 한 트랜잭션에 묶을 Save 의 최대 건수. 1 이면 묶지 않는다.
#
# Save 하나에 드는 시간의 대부분은 질의가 아니라 커밋이다.
# 가장 엄격한 지속성 설정에서는 커밋마다 디스크 동기화가 두 번 일어난다.
# 묶으면 그 비용을 안에 든 요청들이 나눠 갖는다.
#
# 기다렸다 모으지 않는다 - 지금 큐에 있는 것만 묶으므로
# 한가할 때는 배치가 1 이 되고 밀릴 때만 커진다.
#
# 비용: 하나가 실패하면 그 트랜잭션 전체가 되돌아간다.
#       같은 배치에 든 다른 요청도 함께 실패한다
batch_size = 1

[server]
# 수신 포트
listen_port = 9000

# IOCP 워커 스레드 수. 0 이면 코어수/2 로 산정하고 하한 2 · 상한 4 를 적용한다
io_worker_count = 0

# 게임 서비스의 레인 수. 서비스 하나를 그 안에서 다시 나누는 값이다.
# 연결을 식별자로 레인에 고정하므로 레인끼리 상태를 공유하지 않는다.
# 0 이면 1 이다 - 한 서비스가 병목이 됐을 때 올린다.
# 올리면 그 서비스의 세션 표가 레인마다 갈라진다.
# 채팅 서비스는 1 로 고정한다. 나누면 브로드캐스트가 레인 간 전달이 된다
game_lane_count = 0

# 하트비트 무응답 판정 시간(ms)
heartbeat_timeout_ms = 30000

# 동시 접속 상한. 넘어선 접속은 곧바로 끊는다. 0 이면 제한하지 않는다.
# 접속 하나가 수신 버퍼와 송신 누적분을 들고 있어 접속 수가 곧 메모리 사용량이다
max_connections = 8192

# 종료 시 남은 일을 마칠 때까지 기다리는 상한(ms).
# 새 접속과 새 DB 요청을 막은 뒤, 처리 중인 요청과 그 응답 전송을 이 시간 안에 끝낸다
shutdown_drain_ms = 5000

# 연결 하나가 보낼 수 있는 초당 메시지 수. 0 이면 제한하지 않는다.
# 넘어선 메시지는 큐에 넣지 않고 오류 코드 30 으로 답한다.
#
# 기본값을 0 으로 둔 이유 - 부하 측정은 한 연결에서 낼 수 있는 최대치를 재는 것이라
# 제한이 켜져 있으면 그 값을 잴 수 없다. 서비스에서는 켠다
message_rate_limit = 0

# 잠깐 몰리는 몫. 0 이면 위 상한과 같게 둔다.
# 평균만 보면 짧은 폭주를 막지 못하고, 순간값만 보면 정상 사용을 막는다
message_burst = 0

# 아직 내보내지 못한 송신 누적분의 연결당 상한(KB). 0 이면 제한하지 않는다.
#
# 상대가 응답을 읽지 않으면 커널 송신 버퍼가 막히고 그동안 만들어진 응답이 계속 쌓인다.
# 이 상한이 없으면 그 한 연결이 서버 메모리를 끝까지 가져간다.
# 넘어서면 오류로 답하지 않고 곧바로 끊는다 - 오류 응답도 같은 버퍼에 쌓이기 때문이다.
#
# 최악값은 max_connections × 이 값이다. 둘을 함께 정해야 한다
send_buffer_limit_kb = 256

# 관리 포트. 0 이면 열지 않는다.
#   GET /health    200 ok · 503 unavailable (종료 중이거나 DB 커넥션이 전부 끊긴 상태)
#   GET /metrics   수집 도구가 읽는 텍스트 형식
admin_port = 9100

[log]
# 로그 파일 한 개의 상한(MB). 넘거나 날짜가 바뀌면
# logs/server.YYYYMMDD-HHMMSS.log 로 넘기고 새 파일을 연다. 0 이면 넘기지 않는다
max_mb = 64

# 넘긴 파일의 보관 개수. 넘어선 것부터 지운다. 0 이면 지우지 않는다
keep_files = 10

# 발행을 누가 하는가. 어느 쪽이든 전송 순서는 같다.
#   notify - 보내는 쪽은 완료 포트에 통지만 걸고 워커가 WSASend 를 부른다.
#            보내는 쪽 스레드에 송신 비용이 실리지 않는다
#   direct - 보내는 쪽이 그 자리에서 WSASend 를 부른다.
#            시스템 호출이 하나 줄고 완료 포트 왕복이 사라지는 대신
#            발행 비용이 보내는 쪽 스레드에 실린다
# 측정에서 둘의 차이가 관측되지 않았다(docs/benchmark.md). 기본은 notify 다
send_mode = notify

# 관리 포트를 열지 못했을 때 기동을 멈출지. 0 이면 경고만 남기고 계속 뜬다.
# 한 장비에 인스턴스를 둘 이상 띄우면 두 번째의 bind 가 실패한다 -
# 그 상태를 눈치채지 못하는 편이 더 위험한 운영이면 1 로 둔다.
# 포트 자체는 --admin-port 로도 바꿀 수 있다
admin_port_required = 0

# 세션 표를 무엇으로 지키는가.
#   owner - 소속 검사. 한 스레드만 만진다는 약속을 검사로 강제한다.
#           처리가 끝날 때까지 표 안을 가리키는 포인터를 들고 있어도 된다
#   mutex - 잠금. 진입부마다 잡는다.
#           여러 스레드가 함께 쓰려면 잠금 구간을 처리 전체로 넓히거나
#           값을 복사해 돌려주어야 한다 - 구조가 함께 바뀐다
# 접속 2,000 에서 잠금 쪽이 메시지당 처리 시간 약 10% 를 더 쓴다(docs/benchmark.md).
# 기본은 owner 다
session_table_guard = owner

# 서비스 수신 큐의 항목 상한.
# 상한이 없으면 로직이 밀리는 동안 적재만 계속되어 메모리가 늘어난다
inbound_queue_cap = 8192

# 그 큐가 가득 찼을 때 무엇을 할 것인가. 어느 쪽이든 메시지를 잃지는 않는다.
#   reject       - 그 메시지를 거절하고 오류 코드 30 으로 답한다.
#                  상대는 계속 보낼 수 있고, 서버는 거절로 자원을 지킨다
#   backpressure - 그 연결의 수신을 멈춘다. 프레임은 수신 버퍼에 남고
#                  다음 수신을 걸지 않으므로 TCP 창이 줄어 상대가 저절로 느려진다.
#                  거절은 사라지지만 그만큼 상대의 왕복이 길어진다
inbound_full_policy = reject
